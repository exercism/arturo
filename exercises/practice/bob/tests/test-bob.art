import.version:3.0.0 {unitt}!
import {src/bob}!

describe "Bob" [
    it "asking a question" [
        expects.be:'equal? @[
            "Sure."
            response "Does this cryogenic chamber make me look fat?"
        ]
    ]

    it.skip "shouting" [
        expects.be:'equal? @[
            "Whoa, chill out!"
            response "WATCH OUT!"
        ]
    ]

    it.skip "forceful question" [
        expects.be:'equal? @[
            "Calm down, I know what I'm doing!"
            response "WHAT'S GOING ON?"
        ]
    ]

    it.skip "silence" [
        expects.be:'equal? @[
            "Fine. Be that way!"
            response ""
        ]
    ]

    it.skip "stating something" [
        expects.be:'equal? @[
            "Whatever."
            response "Tom-ay-to, tom-aaaah-to."
        ]
    ]

    it.skip "asking a numeric question" [
        expects.be:'equal? @[
            "Sure."
            response "You are, what, like 15?"
        ]
    ]

    it.skip "asking gibberish" [
        expects.be:'equal? @[
            "Sure."
            response "fffbbcbeab?"
        ]
    ]

    it.skip "question with no letters" [
        expects.be:'equal? @[
            "Sure."
            response "4?"
        ]
    ]

    it.skip "non-letters with question" [
        expects.be:'equal? @[
            "Sure."
            response ":) ?"
        ]
    ]

    it.skip "prattling on" [
        expects.be:'equal? @[
            "Sure."
            response "Wait! Hang on. Are you going to be OK?"
        ]
    ]

    it.skip "ending with whitespace" [
        expects.be:'equal? @[
            "Sure."
            response "Okay if like my  spacebar  quite a bit?   "
        ]
    ]

    it.skip "multiple line question" [
        expects.be:'equal? @[
            "Sure."
            response "\nDoes this cryogenic chamber make\n me look fat?"
        ]
    ]

    it.skip "shouting gibberish" [
        expects.be:'equal? @[
            "Whoa, chill out!"
            response "FCECDFCAAB"
        ]
    ]

    it.skip "shouting a statement containing a question mark" [
        expects.be:'equal? @[
            "Whoa, chill out!"
            response "DO LIONS EAT PEOPLE? AHHHHH."
        ]
    ]

    it.skip "shouting numbers" [
        expects.be:'equal? @[
            "Whoa, chill out!"
            response "1, 2, 3 GO!"
        ]
    ]

    it.skip "shouting with special characters" [
        expects.be:'equal? @[
            "Whoa, chill out!"
            response "ZOMG THE %^*@#$(*^ ZOMBIES ARE COMING!!11!!1!"
        ]
    ]

    it.skip "shouting with no exclamation mark" [
        expects.be:'equal? @[
            "Whoa, chill out!"
            response "I HATE THE DENTIST"
        ]
    ]

    it.skip "prolonged silence" [
        expects.be:'equal? @[
            "Fine. Be that way!"
            response "          "
        ]
    ]

    it.skip "alternate silence" [
        expects.be:'equal? @[
            "Fine. Be that way!"
            response "\t\t\t\t\t\t\t\t\t\t"
        ]
    ]

    it.skip "other whitespace" [
        expects.be:'equal? @[
            "Fine. Be that way!"
            response "\n\r \t"
        ]
    ]

    it.skip "talking forcefully" [
        expects.be:'equal? @[
            "Whatever."
            response "Hi there!"
        ]
    ]

    it.skip "using acronyms in regular speech" [
        expects.be:'equal? @[
            "Whatever."
            response "It's OK if you don't want to go work for NASA."
        ]
    ]

    it.skip "no letters" [
        expects.be:'equal? @[
            "Whatever."
            response "1, 2, 3"
        ]
    ]

    it.skip "statement containing question mark" [
        expects.be:'equal? @[
            "Whatever."
            response "Ending with ? means a question."
        ]
    ]

    it.skip "starting with whitespace" [
        expects.be:'equal? @[
            "Whatever."
            response "         hmmmmmmm..."
        ]
    ]

    it.skip "non-question ending with whitespace" [
        expects.be:'equal? @[
            "Whatever."
            response "This is a statement ending with whitespace      "
        ]
    ]
]
